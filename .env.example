# Required for the AI Copy Coach panel.
# Get a key from https://platform.openai.com/api-keys
# In Vercel: Settings → Environment Variables → Add → then redeploy.
OPENAI_API_KEY=sk-...

# Optional override. Defaults to gpt-5.4-mini.
# OPENAI_MODEL=gpt-5.4-mini

# The photo drawer needs no API or env vars — it reads public image URLs you
# add in the drawer (saved in your browser) plus the static seed in photos.js.
