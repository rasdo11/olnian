# Required for the AI Copy Coach panel.
# Get a key from https://platform.openai.com/api-keys
# In Vercel: Settings → Environment Variables → Add → then redeploy.
OPENAI_API_KEY=sk-...

# Optional override. Defaults to gpt-5.4-mini.
# OPENAI_MODEL=gpt-5.4-mini

# Optional: link the brand's Shopify Files library into the photo drawer.
# When both vars are set, the drawer's Sync button pulls every Shopify file and
# merges them with your local paste-in library. If unset, the drawer just shows
# the local library — no error noise.
# Generate the token in Shopify Admin → Settings → Apps and sales channels →
# Develop apps → create a custom app with the read_files scope, install it, and
# copy the Admin API access token (shpat_…).
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_ADMIN_API_TOKEN=shpat_...
